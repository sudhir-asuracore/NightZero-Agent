# Copy to .env, replace placeholders locally, then load it before starting the Agent.
# Do not commit .env or share its values with the Control Panel.
NIGHTZERO_GITHUB_TOKEN=github_pat_replace_with_scoped_fine_grained_token
NIGHTZERO_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
NIGHTZERO_GITHUB_REPOSITORY=sudhir-asuracore/NightZero-TestProject
GOOGLE_API_KEY=replace_with_gemini_api_key
NIGHTZERO_TARGET_REPOSITORY_URL=git@github.com:sudhir-asuracore/NightZero-TestProject.git
NIGHTZERO_CORS_ORIGIN=http://localhost:5173
PORT=8080